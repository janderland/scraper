# Integration Test Credentials
# Copy this file to .env.test and fill in your actual credentials
# NEVER commit .env.test to version control!

# Reddit OAuth Credentials
# Get these from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Instagram Session ID
# Get this from your browser cookies after logging into Instagram
# Cookie name: sessionid
INSTAGRAM_SESSION_ID=your_instagram_session_id_here

# Facebook Graph API Access Token
# Get this from: https://developers.facebook.com/tools/explorer/
# Or from: https://developers.facebook.com/apps
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
